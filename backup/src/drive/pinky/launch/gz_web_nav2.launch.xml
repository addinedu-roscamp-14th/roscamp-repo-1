<?xml version='1.0'?>
<launch>
    <arg name="ip" default="0.0.0.0"/>
    <arg name="port" default="8080"/>
    <arg name="use_sim_time" default="True"/>
    <arg name="params_file" default="$(find-pkg-share drive)/pinky/params/nav2_params.yaml"/>
    <arg name="map" default="$(find-pkg-share drive)/pinky/map/my_map.yaml"/>

    <node pkg="drive" exec="pinky_nav2_web_server" name="nav2_web_server" output="screen">
        <param name="ip" value="$(var ip)"/>
        <param name="port" value="$(var port)"/>
    </node>

    <include file="$(find-pkg-share drive)/pinky/launch/gz_bringup_launch.xml">
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="map" value="$(var map)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

</launch>