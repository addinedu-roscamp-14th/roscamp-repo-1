<?xml version='1.0'?>
<launch>
    <arg name="use_sim_time" default="False"/>
    <arg name="ip" default="0.0.0.0"/>
    <arg name="port" default="8080"/>
    <arg name="save_map_path" default="/home/pinky/current_map"/>
    <arg name="params_file" default="$(find-pkg-share drive)/pinky/params/nav2_params.yaml"/>
    <arg name="slam_params_file" default="$(find-pkg-share drive)/pinky/params/mapper_params.yaml"/>

    <node pkg="drive" exec="pinky_nav2_web_server" name="nav2_web_server" output="screen">
        <param name="ip" value="$(var ip)"/>
        <param name="port" value="$(var port)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="save_map_path" value="$(var save_map_path)"/>
    </node>

    <include file="$(find-pkg-share drive)/pinky/launch/navigation_launch.xml">
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include file="$(find-pkg-share drive)/pinky/launch/map_building.launch.xml">
        <arg name="slam_params_file" value="$(var slam_params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
    
</launch>