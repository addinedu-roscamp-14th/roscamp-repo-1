<?xml version="1.0"?>
<!-- Minimal package-local JetCobot kinematic model for TF publication. -->
<robot name="jetcobot_homography_pick_place">
  <link name="base_link"/>
  <link name="1_Link"/>
  <link name="2_Link"/>
  <link name="3_Link"/>
  <link name="4_Link"/>
  <link name="5_Link"/>
  <link name="6_Link"/>

  <joint name="1_Joint" type="revolute">
    <origin xyz="0 0 0.074520000000001" rpy="0 0 0"/>
    <parent link="base_link"/><child link="1_Link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9321531433504737" upper="2.9321531433504737" effort="0" velocity="0"/>
  </joint>
  <joint name="2_Joint" type="revolute">
    <origin xyz="-2.56344886174708E-05 -0.0349999906124702 0.06" rpy="0 0 0"/>
    <parent link="1_Link"/><child link="2_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.443460952792061" upper="2.443460952792061" effort="0" velocity="0"/>
  </joint>
  <joint name="3_Joint" type="revolute">
    <origin xyz="0 0.00678999562722426 0.109999999944807" rpy="0 0 0"/>
    <parent link="2_Link"/><child link="3_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.6179938779914944" upper="2.6179938779914944" effort="0" velocity="0"/>
  </joint>
  <joint name="4_Joint" type="revolute">
    <origin xyz="0 -0.00134543437627838 0.0959999996761873" rpy="0 0 0"/>
    <parent link="3_Link"/><child link="4_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.6179938779914944" upper="2.6179938779914944" effort="0" velocity="0"/>
  </joint>
  <joint name="5_Joint" type="revolute">
    <origin xyz="-2.51335035583085E-05 -0.0335399905878049 0.0348292449246146" rpy="0 0 0"/>
    <parent link="4_Link"/><child link="5_Link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.705260340591211" upper="2.792526803190927" effort="0" velocity="0"/>
  </joint>
  <joint name="6_Joint" type="revolute">
    <origin xyz="0.0319651869150594 -2.83148869312522E-05 0.03992044757551" rpy="0.785398 0 0"/>
    <parent link="5_Link"/><child link="6_Link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="0" velocity="0"/>
  </joint>
</robot>
