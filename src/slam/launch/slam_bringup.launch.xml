<?xml version='1.0'?>
<launch>
    <arg name="dashboard_params_file" default="config/dashboard/dashboard.yaml"/>
    <arg name="start_dashboard" default="true"/>

    <include if="$(var start_dashboard)" file="$(find-pkg-share dashboard)/launch/dashboard_stream.launch.py">
        <arg name="params_file" value="$(var dashboard_params_file)"/>
    </include>
</launch>
