<?xml version='1.0'?>
<launch>
    <arg name="use_sim_time" default="false"/>
    <arg name="slam_params_file" default="$(find-pkg-share slam)/params/mapper_params.yaml"/>
    <arg name="rviz_config_file" default="$(find-pkg-share slam)/rviz/map_building.rviz"/>
    <arg name="start_rviz" default="true"/>

    <include file="$(find-pkg-share slam)/launch/map_building.launch.xml">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="slam_params_file" value="$(var slam_params_file)"/>
    </include>

    <include if="$(var start_rviz)" file="$(find-pkg-share slam)/launch/map_view.launch.xml">
        <arg name="rviz_config_file" value="$(var rviz_config_file)"/>
    </include>
</launch>
