#!/usr/bin/env python3
"""Relay sparse AMCL poses as a periodic fleet pose heartbeat."""

import copy
import math

from geometry_msgs.msg import PoseWithCovarianceStamped
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node


class AmclPoseHeartbeat(Node):
    def __init__(self):
        super().__init__('amcl_pose_heartbeat')

        self.declare_parameter('input_topic', 'amcl_pose')
        self.declare_parameter('output_topic', 'shared_amcl_pose')
        self.declare_parameter('frame_id', 'map')
        self.declare_parameter('publish_rate', 10.0)

        self.input_topic = str(self.get_parameter('input_topic').value)
        self.output_topic = str(self.get_parameter('output_topic').value)
        self.frame_id = str(self.get_parameter('frame_id').value)
        self.publish_rate = float(self.get_parameter('publish_rate').value)

        if not self.input_topic:
            raise ValueError('input_topic must not be empty')
        if not self.output_topic:
            raise ValueError('output_topic must not be empty')
        if not math.isfinite(self.publish_rate) or self.publish_rate <= 0.0:
            raise ValueError('publish_rate must be finite and greater than zero')

        self.latest_pose = None
        self.publisher = self.create_publisher(
            PoseWithCovarianceStamped, self.output_topic, 10
        )
        self.create_subscription(
            PoseWithCovarianceStamped,
            self.input_topic,
            self._on_pose,
            10,
        )
        self.create_timer(1.0 / self.publish_rate, self._on_timer)

        self.get_logger().info(
            f'AMCL heartbeat: {self.input_topic} -> {self.output_topic} '
            f'at {self.publish_rate:.1f} Hz'
        )

    def _on_pose(self, msg):
        self.latest_pose = msg

    def _on_timer(self):
        if self.latest_pose is None:
            return
        # AMCL is sparse while stationary. Relay its cached pose only while
        # the original local publisher still exists. If AMCL dies, this
        # heartbeat stops and the peer obstacle node can apply its timeout.
        if self.count_publishers(self.input_topic) < 1:
            return

        message = PoseWithCovarianceStamped()
        message.header.stamp = self.get_clock().now().to_msg()
        message.header.frame_id = self.frame_id
        message.pose = copy.deepcopy(self.latest_pose.pose)
        self.publisher.publish(message)


def main(args=None):
    rclpy.init(args=args)
    node = None
    try:
        node = AmclPoseHeartbeat()
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
