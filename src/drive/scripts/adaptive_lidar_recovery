#!/usr/bin/env python3

"""AMR-local LiDAR escape service invoked from the Nav2 behavior tree."""

import math
import threading
import time

from drive.srv import AdaptiveLidarRecovery
from geometry_msgs.msg import PolygonStamped, Twist
from nav2_msgs.srv import ClearEntireCostmap
from nav_msgs.msg import OccupancyGrid, Odometry, Path as PathMsg
import rclpy
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import ExternalShutdownException, MultiThreadedExecutor
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.time import Time
from sensor_msgs.msg import LaserScan
from tf2_ros import Buffer, TransformException, TransformListener


def normalize_angle(angle):
    return (float(angle) + math.pi) % (2.0 * math.pi) - math.pi


def quaternion_to_yaw(orientation):
    return 2.0 * math.atan2(orientation.z, orientation.w)


def point_in_polygon(point, polygon):
    x, y = point
    inside = False
    previous = polygon[-1]
    for current in polygon:
        x1, y1 = previous
        x2, y2 = current
        if (y1 > y) != (y2 > y):
            crossing_x = (x2 - x1) * (y - y1) / (y2 - y1) + x1
            if x <= crossing_x:
                inside = not inside
        previous = current
    return inside


def orientation(a, b, c):
    return (
        (b[0] - a[0]) * (c[1] - a[1])
        - (b[1] - a[1]) * (c[0] - a[0])
    )


def segments_intersect(a, b, c, d):
    epsilon = 1e-9
    o1 = orientation(a, b, c)
    o2 = orientation(a, b, d)
    o3 = orientation(c, d, a)
    o4 = orientation(c, d, b)
    return (
        (o1 * o2 < -epsilon and o3 * o4 < -epsilon)
        or (abs(o1) <= epsilon and point_on_segment(c, a, b))
        or (abs(o2) <= epsilon and point_on_segment(d, a, b))
        or (abs(o3) <= epsilon and point_on_segment(a, c, d))
        or (abs(o4) <= epsilon and point_on_segment(b, c, d))
    )


def point_on_segment(point, start, end):
    epsilon = 1e-9
    return (
        min(start[0], end[0]) - epsilon
        <= point[0]
        <= max(start[0], end[0]) + epsilon
        and min(start[1], end[1]) - epsilon
        <= point[1]
        <= max(start[1], end[1]) + epsilon
    )


def polygon_intersects_cell(polygon, left, bottom, right, top):
    corners = [
        (left, bottom), (right, bottom), (right, top), (left, top),
    ]
    if any(
        left <= point[0] <= right and bottom <= point[1] <= top
        for point in polygon
    ):
        return True
    if any(point_in_polygon(corner, polygon) for corner in corners):
        return True
    polygon_edges = list(zip(polygon, polygon[1:] + polygon[:1]))
    cell_edges = list(zip(corners, corners[1:] + corners[:1]))
    return any(
        segments_intersect(start, end, cell_start, cell_end)
        for start, end in polygon_edges
        for cell_start, cell_end in cell_edges
    )


def transform_footprint(relative_footprint, pose):
    x, y, yaw = pose
    cosine = math.cos(yaw)
    sine = math.sin(yaw)
    return [
        (
            x + cosine * point_x - sine * point_y,
            y + sine * point_x + cosine * point_y,
        )
        for point_x, point_y in relative_footprint
    ]


def footprint_collision(
    costmap, footprint, lethal_threshold=99, unknown_is_collision=True,
):
    if costmap.info.resolution <= 0.0 or len(footprint) < 3:
        return True
    origin = costmap.info.origin
    origin_yaw = quaternion_to_yaw(origin.orientation)
    cosine = math.cos(origin_yaw)
    sine = math.sin(origin_yaw)
    grid_polygon = []
    for point_x, point_y in footprint:
        delta_x = point_x - origin.position.x
        delta_y = point_y - origin.position.y
        grid_polygon.append((
            cosine * delta_x + sine * delta_y,
            -sine * delta_x + cosine * delta_y,
        ))
    resolution = float(costmap.info.resolution)
    width_m = int(costmap.info.width) * resolution
    height_m = int(costmap.info.height) * resolution
    if any(
        x < 0.0 or y < 0.0 or x >= width_m or y >= height_m
        for x, y in grid_polygon
    ):
        return True
    min_column = max(0, int(math.floor(
        min(point[0] for point in grid_polygon) / resolution)))
    max_column = min(int(costmap.info.width) - 1, int(math.floor(
        max(point[0] for point in grid_polygon) / resolution)))
    min_row = max(0, int(math.floor(
        min(point[1] for point in grid_polygon) / resolution)))
    max_row = min(int(costmap.info.height) - 1, int(math.floor(
        max(point[1] for point in grid_polygon) / resolution)))
    for row in range(min_row, max_row + 1):
        for column in range(min_column, max_column + 1):
            index = row * int(costmap.info.width) + column
            value = int(costmap.data[index])
            blocked = value >= lethal_threshold or (
                unknown_is_collision and value < 0
            )
            if not blocked:
                continue
            left = column * resolution
            bottom = row * resolution
            if polygon_intersects_cell(
                grid_polygon, left, bottom,
                left + resolution, bottom + resolution,
            ):
                return True
    return False


def laser_sector_clearance(
    ranges, angle_min, angle_increment, range_min, range_max,
    center_rad, width_rad, percentile=0.2,
):
    values = []
    half_width = abs(float(width_rad)) * 0.5
    usable_max = float(range_max) if math.isfinite(range_max) else 10.0
    for index, raw_range in enumerate(ranges):
        angle = float(angle_min) + index * float(angle_increment)
        if abs(normalize_angle(angle - center_rad)) > half_width:
            continue
        value = float(raw_range)
        if math.isnan(value) or value < float(range_min):
            continue
        if math.isinf(value):
            value = usable_max
        values.append(min(value, usable_max))
    if not values:
        return 0.0
    values.sort()
    index = int(round(min(1.0, max(0.0, percentile)) * (len(values) - 1)))
    return values[index]


def select_reverse_distance(
    rear_clearance_m, short_distance_m, long_distance_m,
    long_clearance_threshold_m,
):
    if rear_clearance_m >= long_clearance_threshold_m:
        return long_distance_m
    return short_distance_m


def path_rejoin_heading(path_points, current_xy, lookahead_m):
    """Return the forward tangent of the original path near the robot."""
    if len(path_points) < 2:
        return None
    nearest = min(
        range(len(path_points)),
        key=lambda index: math.hypot(
            path_points[index][0] - current_xy[0],
            path_points[index][1] - current_xy[1],
        ),
    )
    start = path_points[nearest]
    travelled = 0.0
    for index in range(nearest + 1, len(path_points)):
        previous = path_points[index - 1]
        current = path_points[index]
        segment = math.hypot(
            current[0] - previous[0], current[1] - previous[1])
        travelled += segment
        if travelled >= lookahead_m and math.hypot(
            current[0] - start[0], current[1] - start[1]
        ) > 1e-6:
            return math.atan2(current[1] - start[1], current[0] - start[0])
    if nearest > 0:
        previous = path_points[nearest - 1]
        end = path_points[-1]
        if math.hypot(end[0] - previous[0], end[1] - previous[1]) > 1e-6:
            return math.atan2(end[1] - previous[1], end[0] - previous[0])
    end = path_points[-1]
    if math.hypot(end[0] - start[0], end[1] - start[1]) <= 1e-6:
        return None
    return math.atan2(end[1] - start[1], end[0] - start[0])


def heading_alignment_rate(
    current_yaw, desired_yaw, remaining_time,
    maximum_rate, deadband_rad,
):
    """Choose yaw rate that reaches the path heading by reverse end."""
    error = normalize_angle(desired_yaw - current_yaw)
    if abs(error) <= abs(deadband_rad):
        return 0.0
    rate = error / max(0.05, float(remaining_time))
    return max(-abs(maximum_rate), min(abs(maximum_rate), rate))


class AdaptiveLidarRecoveryNode(Node):
    def __init__(self):
        super().__init__('adaptive_lidar_recovery')
        defaults = {
            'scan_topic': 'scan',
            'odom_topic': 'odom',
            'path_topic': 'plan',
            'local_costmap_topic': 'local_costmap/costmap',
            'footprint_topic': 'local_costmap/published_footprint',
            'cmd_vel_topic': 'cmd_vel_nav',
            'clear_local_costmap_service': (
                'local_costmap/clear_entirely_local_costmap'
            ),
            'clear_global_costmap_service': (
                'global_costmap/clear_entirely_global_costmap'
            ),
            'scan_max_age_sec': 1.0,
            'costmap_max_age_sec': 1.0,
            'footprint_max_age_sec': 1.0,
            'lethal_cost_threshold': 99,
            'unknown_is_collision': True,
            'reverse_distance_m': 0.05,
            'reverse_long_distance_m': 0.10,
            'reverse_long_clearance_m': 0.10,
            'reverse_speed_mps': 0.04,
            'reverse_stop_clearance_m': 0.01,
            # Allow a stronger reverse arc so the vehicle can finish the
            # recovery facing the original path before Nav2 replans.
            'reverse_heading_max_speed_rps': 0.30,
            'reverse_heading_deadband_deg': 2.0,
            'reverse_side_sector_width_deg': 50.0,
            'path_max_age_sec': 5.0,
            'path_heading_lookahead_m': 0.12,
            'timeout_sec': 15.0,
            'command_rate_hz': 15.0,
            'clear_service_timeout_sec': 3.0,
            'costmap_rebuild_wait_sec': 0.4,
        }
        for name, value in defaults.items():
            self.declare_parameter(name, value)
        self.scan_max_age = float(self.get_parameter('scan_max_age_sec').value)
        self.costmap_max_age = float(
            self.get_parameter('costmap_max_age_sec').value)
        self.footprint_max_age = float(
            self.get_parameter('footprint_max_age_sec').value)
        self.lethal_cost_threshold = int(
            self.get_parameter('lethal_cost_threshold').value)
        self.unknown_is_collision = bool(
            self.get_parameter('unknown_is_collision').value)
        self.reverse_distance = float(
            self.get_parameter('reverse_distance_m').value)
        self.reverse_long_distance = float(
            self.get_parameter('reverse_long_distance_m').value)
        self.reverse_long_clearance = float(
            self.get_parameter('reverse_long_clearance_m').value)
        self.reverse_speed = float(
            self.get_parameter('reverse_speed_mps').value)
        self.reverse_stop_clearance = float(
            self.get_parameter('reverse_stop_clearance_m').value)
        self.reverse_heading_max_speed = float(
            self.get_parameter('reverse_heading_max_speed_rps').value)
        self.reverse_heading_deadband = math.radians(float(
            self.get_parameter('reverse_heading_deadband_deg').value))
        self.reverse_side_sector_width = math.radians(float(
            self.get_parameter('reverse_side_sector_width_deg').value))
        self.path_max_age = float(
            self.get_parameter('path_max_age_sec').value)
        self.path_heading_lookahead = float(
            self.get_parameter('path_heading_lookahead_m').value)
        self.timeout = float(self.get_parameter('timeout_sec').value)
        self.command_period = 1.0 / float(
            self.get_parameter('command_rate_hz').value)
        self.clear_timeout = float(
            self.get_parameter('clear_service_timeout_sec').value)
        self.costmap_rebuild_wait = float(
            self.get_parameter('costmap_rebuild_wait_sec').value)
        self._lock = threading.RLock()
        self._operation_lock = threading.Lock()
        self._latest_scan = None
        self._scan_received_at = None
        self._yaw = None
        self._pose = None
        self._odom_frame = ''
        self._odom_received_at = None
        self._latest_path = None
        self._path_received_at = None
        self._latest_costmap = None
        self._costmap_received_at = None
        self._relative_footprint = None
        self._footprint_received_at = None
        group = ReentrantCallbackGroup()
        self._tf_buffer = Buffer()
        self._tf_listener = TransformListener(
            self._tf_buffer, self, spin_thread=False)
        self._cmd_pub = self.create_publisher(
            Twist, str(self.get_parameter('cmd_vel_topic').value), 10)
        self.create_subscription(
            LaserScan, str(self.get_parameter('scan_topic').value),
            self._on_scan, qos_profile_sensor_data, callback_group=group)
        self.create_subscription(
            Odometry, str(self.get_parameter('odom_topic').value),
            self._on_odom, qos_profile_sensor_data, callback_group=group)
        self.create_subscription(
            PathMsg, str(self.get_parameter('path_topic').value),
            self._on_path, 10, callback_group=group)
        self.create_subscription(
            OccupancyGrid,
            str(self.get_parameter('local_costmap_topic').value),
            self._on_costmap,
            10,
            callback_group=group,
        )
        self.create_subscription(
            PolygonStamped,
            str(self.get_parameter('footprint_topic').value),
            self._on_footprint,
            10,
            callback_group=group,
        )
        self._clear_local_client = self.create_client(
            ClearEntireCostmap,
            str(self.get_parameter('clear_local_costmap_service').value),
            callback_group=group,
        )
        self._clear_global_client = self.create_client(
            ClearEntireCostmap,
            str(self.get_parameter('clear_global_costmap_service').value),
            callback_group=group,
        )
        self.create_service(
            AdaptiveLidarRecovery, 'adaptive_lidar_recovery',
            self._recover, callback_group=group)
        self.get_logger().info(
            'AMR-local adaptive LiDAR recovery ready: reverse 0.10m when '
            'rear clearance >= 0.10m, otherwise 0.05m; steer the final '
            'heading toward the original path, clear local/global costmaps '
            'and regenerate the path')

    def _on_scan(self, message):
        with self._lock:
            self._latest_scan = message
            self._scan_received_at = time.monotonic()

    def _on_odom(self, message):
        with self._lock:
            pose = message.pose.pose
            self._yaw = quaternion_to_yaw(pose.orientation)
            self._pose = (pose.position.x, pose.position.y, self._yaw)
            self._odom_frame = str(message.header.frame_id)
            self._odom_received_at = time.monotonic()

    def _on_path(self, message):
        with self._lock:
            self._latest_path = message
            self._path_received_at = time.monotonic()

    def _on_costmap(self, message):
        with self._lock:
            self._latest_costmap = message
            self._costmap_received_at = time.monotonic()

    def _on_footprint(self, message):
        with self._lock:
            if self._pose is None or len(message.polygon.points) < 3:
                return
            pose_x, pose_y, pose_yaw = self._pose
            cosine = math.cos(pose_yaw)
            sine = math.sin(pose_yaw)
            relative = []
            for point in message.polygon.points:
                delta_x = float(point.x) - pose_x
                delta_y = float(point.y) - pose_y
                relative.append((
                    cosine * delta_x + sine * delta_y,
                    -sine * delta_x + cosine * delta_y,
                ))
            self._relative_footprint = relative
            self._footprint_received_at = time.monotonic()

    def _fresh_state(self):
        with self._lock:
            if (
                self._latest_scan is None
                or self._scan_received_at is None
                or time.monotonic() - self._scan_received_at
                > self.scan_max_age
            ):
                return None, None
            return self._latest_scan, self._yaw

    def _fresh_motion_state(self):
        now = time.monotonic()
        with self._lock:
            if self._pose is None:
                return None, 'no odometry pose'
            if (
                self._latest_costmap is None
                or self._costmap_received_at is None
                or now - self._costmap_received_at > self.costmap_max_age
            ):
                return None, 'local costmap is unavailable or stale'
            if (
                self._relative_footprint is None
                or self._footprint_received_at is None
                or now - self._footprint_received_at > self.footprint_max_age
            ):
                return None, 'published footprint is unavailable or stale'
            return (
                self._pose,
                self._latest_costmap,
                list(self._relative_footprint),
            ), ''

    def _predicted_pose_is_safe(self, predicted_pose):
        state, message = self._fresh_motion_state()
        if state is None:
            return False, message
        _, costmap, relative_footprint = state
        predicted_footprint = transform_footprint(
            relative_footprint, predicted_pose)
        if footprint_collision(
            costmap,
            predicted_footprint,
            lethal_threshold=self.lethal_cost_threshold,
            unknown_is_collision=self.unknown_is_collision,
        ):
            return (
                False,
                'predicted footprint intersects costmap collision cell',
            )
        return True, ''

    def _publish_stop(self):
        self._cmd_pub.publish(Twist())

    def _rear_clearance(self, scan):
        return laser_sector_clearance(
            scan.ranges, scan.angle_min, scan.angle_increment,
            scan.range_min, scan.range_max, math.pi, math.radians(50.0),
        )

    def _rear_side_clearances(self, scan):
        common = (
            scan.ranges,
            scan.angle_min,
            scan.angle_increment,
            scan.range_min,
            scan.range_max,
        )
        rear_left = laser_sector_clearance(
            *common, math.radians(135.0), self.reverse_side_sector_width)
        rear_right = laser_sector_clearance(
            *common, math.radians(-135.0), self.reverse_side_sector_width)
        return rear_left, rear_right

    def _path_heading_in_odom(self):
        with self._lock:
            path = self._latest_path
            received_at = self._path_received_at
            pose = self._pose
            odom_frame = self._odom_frame
        if (
            path is None
            or received_at is None
            or time.monotonic() - received_at > self.path_max_age
            or pose is None
            or not odom_frame
            or len(path.poses) < 2
        ):
            return None, 'fresh original path or odometry is unavailable'
        path_frame = str(path.header.frame_id or path.poses[0].header.frame_id)
        if not path_frame:
            return None, 'original path frame is empty'
        transform_yaw = 0.0
        translation_x = 0.0
        translation_y = 0.0
        if path_frame != odom_frame:
            try:
                transform = self._tf_buffer.lookup_transform(
                    odom_frame, path_frame, Time()).transform
            except TransformException as error:
                return None, f'path-to-odom TF unavailable: {error}'
            transform_yaw = quaternion_to_yaw(transform.rotation)
            translation_x = float(transform.translation.x)
            translation_y = float(transform.translation.y)
        cosine = math.cos(transform_yaw)
        sine = math.sin(transform_yaw)
        points = []
        for stamped_pose in path.poses:
            point = stamped_pose.pose.position
            points.append((
                translation_x + cosine * point.x - sine * point.y,
                translation_y + sine * point.x + cosine * point.y,
            ))
        heading = path_rejoin_heading(
            points, pose[:2], self.path_heading_lookahead)
        if heading is None:
            return None, 'original path has no usable forward tangent'
        return heading, ''

    def _reverse(self, deadline):
        scan, _ = self._fresh_state()
        if scan is None:
            return False, 'no fresh LiDAR scan for safe recovery reverse'
        clearance = self._rear_clearance(scan)
        reverse_distance = select_reverse_distance(
            clearance,
            self.reverse_distance,
            self.reverse_long_distance,
            self.reverse_long_clearance,
        )
        desired_heading, heading_message = self._path_heading_in_odom()
        if desired_heading is None:
            reverse_distance = self.reverse_distance
            self.get_logger().warning(
                f'Path-heading recovery fallback to straight reverse: '
                f'{heading_message}')
        self.get_logger().info(
            f'Recovery reverse selected: rear={clearance:.3f}m, '
            f'target={reverse_distance:.3f}m, '
            f'path_heading_deg='
            f'{math.degrees(desired_heading):.1f}'
            if desired_heading is not None
            else f'Recovery reverse selected: rear={clearance:.3f}m, '
                 f'target={reverse_distance:.3f}m, path_heading=unavailable')
        stop_at = min(
            deadline,
            time.monotonic() + reverse_distance / self.reverse_speed,
        )
        command = Twist()
        command.linear.x = -abs(self.reverse_speed)
        command_count = 0
        try:
            while time.monotonic() < stop_at:
                scan, _ = self._fresh_state()
                if scan is None:
                    return False, 'LiDAR became stale while reversing'
                current_rear = self._rear_clearance(scan)
                current_left, current_right = self._rear_side_clearances(scan)
                with self._lock:
                    current_yaw = self._yaw
                remaining_time = max(
                    self.command_period, stop_at - time.monotonic())
                steering = 0.0
                if desired_heading is not None and current_yaw is not None:
                    steering = heading_alignment_rate(
                        current_yaw,
                        desired_heading,
                        remaining_time,
                        self.reverse_heading_max_speed,
                        self.reverse_heading_deadband,
                    )
                command.angular.z = steering
                # Negative yaw curves the reversing rear left; positive yaw
                # curves it right. Check that swept rear-side with raw LiDAR.
                steered_side = (
                    'left' if steering < 0.0
                    else 'right' if steering > 0.0
                    else 'center'
                )
                steered_clearance = (
                    current_left if steered_side == 'left'
                    else current_right if steered_side == 'right'
                    else current_rear
                )
                if min(current_rear, steered_clearance) \
                        <= self.reverse_stop_clearance:
                    self.get_logger().warning(
                        'Physical rear/steered-side LiDAR stop reached during '
                        'recovery')
                    break
                self._cmd_pub.publish(command)
                command_count += 1
                time.sleep(self.command_period)
        finally:
            self._publish_stop()
        self.get_logger().info(
            f'Path-heading recovery reverse completed: '
            f'target={reverse_distance:.3f}m, commands={command_count}, '
            f'final_angular_z={command.angular.z:.3f}rad/s')
        time.sleep(0.2)
        return True, ''

    def _call_clear_service(self, client, label):
        if not client.wait_for_service(timeout_sec=self.clear_timeout):
            self.get_logger().error(
                f'{label} costmap clear service unavailable')
            return False
        future = client.call_async(ClearEntireCostmap.Request())
        deadline = time.monotonic() + self.clear_timeout
        while not future.done() and time.monotonic() < deadline:
            time.sleep(0.02)
        if not future.done() or future.exception() is not None:
            self.get_logger().error(f'{label} costmap clear service failed')
            return False
        return True

    def _clear_costmaps(self):
        local_ok = self._call_clear_service(
            self._clear_local_client, 'local')
        global_ok = self._call_clear_service(
            self._clear_global_client, 'global')
        return local_ok and global_ok

    def _clear_rebuild_costmap(self):
        if not self._clear_costmaps():
            return False
        time.sleep(max(0.0, self.costmap_rebuild_wait))
        return True

    def _recover(self, request, response):
        if not self._operation_lock.acquire(blocking=False):
            response.success = False
            response.message = 'another recovery is already running'
            return response
        try:
            deadline = time.monotonic() + self.timeout
            success, message = self._reverse(deadline)
            if not success:
                response.success = False
                response.message = message
                return response
            if not self._clear_rebuild_costmap():
                response.success = False
                response.message = 'local/global costmap clear service failed'
                return response
            self.get_logger().info(
                'Reverse recovery completed; local/global costmaps cleared '
                'and rebuilt for the next path generation')
            response.success = True
            response.message = (
                'reverse completed; local/global costmaps rebuilt for path '
                'regeneration')
            return response
        finally:
            self._publish_stop()
            self._operation_lock.release()


def main(args=None):
    rclpy.init(args=args)
    node = AdaptiveLidarRecoveryNode()
    executor = MultiThreadedExecutor(num_threads=4)
    executor.add_node(node)
    try:
        executor.spin()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        executor.shutdown()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
