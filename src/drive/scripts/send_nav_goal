#!/usr/bin/env python3

import argparse
import math
import os
import sys

from nav2_msgs.action import NavigateToPose
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node


DEFAULT_MAP = '/home/jio/poter_ws/config/SLAM/current_map.yaml'


def read_map_yaml(path):
    values = {}
    with open(path, 'r', encoding='utf-8') as stream:
        for raw_line in stream:
            line = raw_line.split('#', 1)[0].strip()
            if not line or ':' not in line:
                continue
            key, value = line.split(':', 1)
            values[key.strip()] = value.strip()

    try:
        resolution = float(values['resolution'])
        origin = values['origin'].strip().strip('[]')
        origin_x, origin_y, _ = [float(value.strip()) for value in origin.split(',')]
        image = values['image']
    except (KeyError, ValueError) as exc:
        raise ValueError(f'Invalid map yaml: {path}') from exc

    image_path = image if os.path.isabs(image) else os.path.join(os.path.dirname(path), image)
    width, height = read_pgm_size(image_path)
    return {
        'resolution': resolution,
        'origin_x': origin_x,
        'origin_y': origin_y,
        'width': width,
        'height': height,
    }


def read_pgm_size(path):
    with open(path, 'rb') as stream:
        magic = stream.readline().strip()
        if magic not in (b'P5', b'P2'):
            raise ValueError(f'Unsupported PGM format in {path}: {magic!r}')

        line = stream.readline()
        while line.startswith(b'#'):
            line = stream.readline()
        return [int(value) for value in line.split()]


def pixel_to_world(px, py, map_info, canvas_width, canvas_height):
    scale = min(canvas_width / map_info['width'], canvas_height / map_info['height'])
    ix = px / scale
    iy = map_info['height'] - 1 - (py / scale)
    wx = map_info['origin_x'] + ix * map_info['resolution']
    wy = map_info['origin_y'] + iy * map_info['resolution']
    return wx, wy, ix, iy


class NavGoalSender(Node):
    def __init__(self):
        super().__init__('send_nav_goal')
        self.client = ActionClient(self, NavigateToPose, 'navigate_to_pose')

    def send_goal(self, x, y, yaw, timeout_sec):
        if not self.client.wait_for_server(timeout_sec=timeout_sec):
            raise RuntimeError('navigate_to_pose action server is not available')

        goal = NavigateToPose.Goal()
        goal.pose.header.frame_id = 'map'
        goal.pose.header.stamp = self.get_clock().now().to_msg()
        goal.pose.pose.position.x = x
        goal.pose.pose.position.y = y
        goal.pose.pose.orientation.z = math.sin(yaw / 2.0)
        goal.pose.pose.orientation.w = math.cos(yaw / 2.0)

        future = self.client.send_goal_async(goal)
        rclpy.spin_until_future_complete(self, future)
        handle = future.result()
        if handle is None or not handle.accepted:
            raise RuntimeError('goal was rejected')

        result_future = handle.get_result_async()
        rclpy.spin_until_future_complete(self, result_future)
        result = result_future.result()
        return result.status, result.result


def build_parser():
    parser = argparse.ArgumentParser(
        description='Send a Nav2 goal from map/world coordinates or canvas pixel coordinates.'
    )
    parser.add_argument('x', type=float)
    parser.add_argument('y', type=float)
    parser.add_argument('--world', action='store_true', help='Treat x/y as map-frame meters.')
    parser.add_argument('--yaw', type=float, default=0.0, help='Goal yaw in radians.')
    parser.add_argument('--map', default=DEFAULT_MAP)
    parser.add_argument('--canvas-width', type=float, default=720.0)
    parser.add_argument('--canvas-height', type=float, default=720.0)
    parser.add_argument('--timeout', type=float, default=10.0)
    parser.add_argument('--dry-run', action='store_true')
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)

    if args.world:
        goal_x, goal_y = args.x, args.y
        print(f'world goal: x={goal_x:.6f}, y={goal_y:.6f}, yaw={args.yaw:.6f}')
    else:
        map_info = read_map_yaml(args.map)
        goal_x, goal_y, ix, iy = pixel_to_world(
            args.x, args.y, map_info, args.canvas_width, args.canvas_height
        )
        print(
            f'pixel goal: px={args.x:.3f}, py={args.y:.3f}, '
            f'cell=({ix:.3f}, {iy:.3f}), world=({goal_x:.6f}, {goal_y:.6f}), '
            f'yaw={args.yaw:.6f}'
        )

    if args.dry_run:
        return 0

    rclpy.init()
    node = NavGoalSender()
    try:
        status, result = node.send_goal(goal_x, goal_y, args.yaw, args.timeout)
        print(
            f'result status={status}, error_code={result.error_code}, '
            f'error_msg={result.error_msg!r}'
        )
        return 0 if status == 4 else 1
    except Exception as exc:
        print(f'failed: {exc}', file=sys.stderr)
        return 1
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    sys.exit(main())
