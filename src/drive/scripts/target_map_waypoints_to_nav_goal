#!/usr/bin/env python3

from action_msgs.msg import GoalStatus
from nav2_msgs.action import NavigateThroughPoses
from nav_msgs.msg import Path
import rclpy
from rclpy.action import ActionClient
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node


class TargetMapWaypointsToNavGoal(Node):
    def __init__(self):
        super().__init__('target_map_waypoints_to_nav_goal')

        self.declare_parameter(
            'waypoints_topic', '/central/target_map_waypoints'
        )
        self.declare_parameter('action_name', 'navigate_through_poses')
        self.declare_parameter('default_frame_id', 'map')
        self.declare_parameter('wait_for_server_timeout_sec', 10.0)

        self.waypoints_topic = str(
            self.get_parameter('waypoints_topic').value
        )
        self.action_name = str(self.get_parameter('action_name').value)
        self.default_frame_id = str(
            self.get_parameter('default_frame_id').value
        )
        self.wait_timeout = float(
            self.get_parameter('wait_for_server_timeout_sec').value
        )

        self.client = ActionClient(
            self, NavigateThroughPoses, self.action_name
        )
        self.active_goal = None
        self.received_path_count = 0

        self.create_subscription(Path, self.waypoints_topic, self.on_path, 10)
        self.create_timer(5.0, self.log_waiting_status)
        self.get_logger().info(
            f'Subscribing waypoint paths: {self.waypoints_topic}; '
            f'sending Nav2 goals to action: {self.action_name}'
        )

    def on_path(self, path_msg):
        self.received_path_count += 1
        if not path_msg.poses:
            self.get_logger().warning('Ignored an empty waypoint path')
            return

        frame_id = path_msg.header.frame_id or self.default_frame_id
        now = self.get_clock().now().to_msg()
        goal = NavigateThroughPoses.Goal()
        goal.poses = list(path_msg.poses)
        for pose in goal.poses:
            pose.header.frame_id = pose.header.frame_id or frame_id
            if pose.header.frame_id != frame_id:
                self.get_logger().error(
                    'All waypoints must use one frame: '
                    f'expected={frame_id}, received={pose.header.frame_id}'
                )
                return
            if pose.header.stamp.sec == 0 and pose.header.stamp.nanosec == 0:
                pose.header.stamp = now

        if not self.client.wait_for_server(timeout_sec=self.wait_timeout):
            self.get_logger().error(
                f'Nav2 action server is not available: {self.action_name}'
            )
            return

        if self.active_goal is not None:
            self.get_logger().info('Canceling previous waypoint navigation goal')
            self.active_goal.cancel_goal_async()
            self.active_goal = None

        future = self.client.send_goal_async(goal)
        future.add_done_callback(self.on_goal_response)
        self.get_logger().info(
            f'Sent {len(goal.poses)} waypoint(s) to Nav2 in frame {frame_id}'
        )

    def log_waiting_status(self):
        if self.received_path_count > 0:
            return
        self.get_logger().info(
            'Waiting for waypoint path: '
            f'topic={self.waypoints_topic}, '
            f'publishers={self.count_publishers(self.waypoints_topic)}, '
            f'action={self.action_name}, '
            f'action_server_ready={self.client.server_is_ready()}'
        )

    def on_goal_response(self, future):
        try:
            goal_handle = future.result()
        except Exception as exc:
            self.get_logger().error(f'Failed to send waypoint goal: {exc}')
            return

        if goal_handle is None or not goal_handle.accepted:
            self.get_logger().warning('Waypoint navigation goal was rejected')
            return

        self.active_goal = goal_handle
        result_future = goal_handle.get_result_async()
        result_future.add_done_callback(self.on_goal_result)

    def on_goal_result(self, future):
        try:
            result = future.result()
        except Exception as exc:
            self.get_logger().error(f'Failed to receive waypoint result: {exc}')
            self.active_goal = None
            return

        self.active_goal = None
        result_name = {
            GoalStatus.STATUS_SUCCEEDED: 'SUCCEEDED',
            GoalStatus.STATUS_CANCELED: 'CANCELED',
            GoalStatus.STATUS_ABORTED: 'ABORTED',
        }.get(result.status, str(result.status))
        self.get_logger().info(
            'Waypoint navigation finished: '
            f'status={result_name}, '
            f'error_code={result.result.error_code}, '
            f'error_msg={result.result.error_msg!r}'
        )


def main(args=None):
    rclpy.init(args=args)
    node = TargetMapWaypointsToNavGoal()

    try:
        rclpy.spin(node)
    except (ExternalShutdownException, KeyboardInterrupt):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
