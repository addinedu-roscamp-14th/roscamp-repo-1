<?xml version='1.0'?>
<launch>
    <arg name="workspace" default="$(env HOME)/poter_ws"/>
    <arg name="map" default="$(var workspace)/config/SLAM/current_map.yaml"/>
    <arg name="keepout_mask" default="$(var workspace)/config/SLAM/keepout_mask.yaml"/>
    <arg name="use_sim_time" default="false"/>
    <arg name="params_file" default="$(find-pkg-share drive)/params/nav2_params.yaml"/>
    <arg name="start_nav2" default="false"/>
    <arg name="target_topic" default="/central/target_map_pose"/>
    <arg name="action_name" default="navigate_to_pose"/>
    <arg name="default_frame_id" default="map"/>

    <include if="$(var start_nav2)" file="$(find-pkg-share drive)/launch/bringup_launch.xml">
        <arg name="workspace" value="$(var workspace)"/>
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="map" value="$(var map)"/>
        <arg name="keepout_mask" value="$(var keepout_mask)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <node pkg="drive" exec="target_map_pose_to_nav_goal" name="target_map_pose_to_nav_goal" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="target_topic" value="$(var target_topic)"/>
        <param name="action_name" value="$(var action_name)"/>
        <param name="default_frame_id" value="$(var default_frame_id)"/>
    </node>
</launch>
