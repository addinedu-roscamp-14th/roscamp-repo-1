<?xml version='1.0'?>
<launch>
    <arg name="use_sim_time" default="false"/>
    <arg name="pose_array_topic" default="/central/target_map_poses"/>
    <arg name="path_topic" default="/central/target_map_path"/>
    <arg name="action_name" default="navigate_through_poses"/>
    <arg name="default_frame_id" default="map"/>

    <node pkg="drive" exec="target_waypoints_to_nav_goal" name="target_waypoints_to_nav_goal" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="pose_array_topic" value="$(var pose_array_topic)"/>
        <param name="path_topic" value="$(var path_topic)"/>
        <param name="action_name" value="$(var action_name)"/>
        <param name="default_frame_id" value="$(var default_frame_id)"/>
    </node>
</launch>
