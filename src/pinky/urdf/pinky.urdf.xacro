<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="insert_robot" params="namespace is_sim:=false cam_tilt_deg screen_tilt_deg">
        <xacro:include filename="$(find pinky)/urdf/common/insert_inertia.urdf.xacro"/>
        <!-- upload_robot.launch.py passes the namespace with a trailing slash. -->
        <xacro:property name="vehicle_id" value="${namespace.strip('/') or 'unknown'}"/>
        <xacro:property name="cargo_rgba" value="${
            '0.12 0.42 0.92 1.0' if vehicle_id == 'agv1' else
            ('1.00 0.78 0.05 1.0' if vehicle_id == 'agv2' else
             '0.80 0.10 0.10 1.0')
        }"/>

        <!-- Declared at robot scope rather than inline in the visual below.
             RViz resolves a link's material from its FIRST <visual>, and
             base_link's first visual is the untextured mesh; a material
             attached to the second visual is never found and the box renders
             with the RVIZ/ShadedRed fallback. The vehicle id is part of the
             name so two robot models in one RViz cannot collide on it. -->
        <material name="cargo_box_${vehicle_id}">
            <color rgba="${cargo_rgba}"/>
        </material>

        <link name="base_footprint"/>
        <link name="base_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/base_link.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <visual>
                <origin xyz="0.121 0 0" rpy="0 0 ${pi}"/>
                <geometry>
                    <box size="0.102 0.08 0.086"/>
                </geometry>
                <material name="cargo_box_${vehicle_id}"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/base_link.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <collision>
                <origin xyz="0.121 0 0" rpy="0 0 ${pi}"/>
                <geometry>
                    <box size="0.102 0.08 0.086"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.025 0 0.025" rpy="0 0 ${pi}"/>
                <mass value="0.8"/>
                <xacro:box_inertia m="0.8" x="0.09" y="0.08" z="0.086"/>
            </inertial>
        </link>

        <joint name="base_link_fixed_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 0.028" rpy="0 0 0"/>
        </joint>

        <xacro:macro name="insert_wheel" params="side dir">
            <link name="${side}_wheel">
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 ${dir*pi/2}"/>
                    <geometry>
                        <mesh filename="package://pinky/meshes/visual/main_wheel.dae" scale="1 1 1"/>
                    </geometry>
                </visual>
                <collision>
                    <origin xyz="0 ${dir*0.008} 0" rpy="0 0 0"/>
                    <geometry>
                        <sphere radius="0.028"/>
                    </geometry>
                </collision>
                <inertial>
                    <origin xyz="0 ${dir*0.008} 0" rpy="0 0 0"/>
                    <mass value="0.2"/>
                    <xacro:sphere_inertia m="0.2" r="0.028"/>
                </inertial>
            </link>

            <joint name="${namespace}${side}_wheel_joint" type="continuous">
                <parent link="base_link"/>
                <child link="${side}_wheel"/>
                <axis xyz="0 1 0"/>
                <origin xyz="0 ${-dir*0.04055} 0" rpy="0 0 ${pi}"/>
            </joint>
        </xacro:macro>

        <xacro:insert_wheel side="l" dir="1"/>
        <xacro:insert_wheel side="r" dir="-1"/>

        <link name="caster_mount_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/caster_mount.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/caster_mount.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 -0.0015" rpy="0 0 0"/>
                <mass value="0.1"/>
                <xacro:box_inertia m="0.1" x="0.028" y="0.027" z="0.0035"/>
            </inertial>
        </link>

        <joint name="${namespace}caster_mount_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="caster_mount_link"/>
            <origin xyz="0.0585 0 -0.007" rpy="0 0 ${pi}"/>
        </joint>

        <link name="caster_roate_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/caster_rotate.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/caster_rotate.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.010 0 -0.006" rpy="0 0 0"/>
                <mass value="0.05"/>
                <xacro:box_inertia m="0.05" x="0.018" y="0.016" z="0.010"/>
            </inertial>
        </link>

        <joint name="${namespace}caster_rotate_joint" type="continuous">
            <parent link="caster_mount_link"/>
            <child link="caster_roate_link"/>
            <axis xyz="0 0 1"/>
            <origin xyz="0 0 -0.0035" rpy="0 0 0"/>
        </joint>

        <link name="caster_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/caster_wheel.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.0065"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.05"/>
                <xacro:sphere_inertia m="0.05" r="0.0065"/>
            </inertial>
        </link>

        <joint name="${namespace}caster_wheel_joint" type="continuous">
            <parent link="caster_roate_link"/>
            <child link="caster_wheel"/>
            <axis xyz="0 1 0"/>
            <origin xyz="-0.011 0 -0.011" rpy="0 0 0"/>
        </joint>

        <link name="robot_lamp">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/robot_lamp.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/robot_lamp.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.06425 0 0.078" rpy="0 0 0"/>
                <mass value="0.01"/>
                <xacro:box_inertia m="0.01" x="0.0165" y="0.058" z="0.018"/>
            </inertial>
        </link>

        <joint name="${namespace}robot_lamp_mount_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="robot_lamp"/>
            <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        </joint>

        <link name="rplidar_mount">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/rplidar_c1.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/rplidar_c1.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0.021" rpy="0 0 0"/>
                <mass value="0.11"/>
                <xacro:cylinder_inertia m="0.11" r="0.025" h="0.042"/>
            </inertial>
        </link>

        <joint name="${namespace}rplidar_mount_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="rplidar_mount"/>
            <origin xyz="0.017 0 0.067" rpy="0 0 ${pi}"/>
        </joint>

        <link name="rplidar_link"/>
        <joint name="${namespace}rplidar_link_fixed_joint" type="fixed">
            <parent link="rplidar_mount"/>
            <child link="rplidar_link"/>
            <origin xyz="0 0 0.030" rpy="0 0 ${pi}"/>
        </joint>

        <link name="front_camera_mount">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/camera_assy.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/camera_assy.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.01 0 -0.0121" rpy="0 0 0"/>
                <mass value="0.01"/>
                <xacro:box_inertia m="0.01" x="0.0165" y="0.045" z="0.030"/>
            </inertial>
        </link>

        <joint name="${namespace}front_camera_mount_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="front_camera_mount"/>
            <origin xyz="-0.020 0 0.0495" rpy="0 ${cam_tilt_deg/180*pi} ${pi}"/>
        </joint>

        <link name="front_camera_link"/>
        <joint name="${namespace}front_camera_fixed_joint" type="fixed">
            <parent link="front_camera_mount"/>
            <child link="front_camera_link"/>
            <origin xyz="0.015 0 -0.0121" rpy="0 0 0"/>
        </joint>

        <link name="screen_mount">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/visual/screen_assy.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://pinky/meshes/collision/screen_assy.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.01 0 -0.004" rpy="0 0 0"/>
                <mass value="0.01"/>
                <xacro:box_inertia m="0.01" x="0.012" y="0.071" z="0.041"/>
            </inertial>
        </link>

        <joint name="${namespace}screen_mount_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="screen_mount"/>
            <origin xyz="-0.0165 0 0.071" rpy="0 ${screen_tilt_deg/180*pi} ${pi}"/>
        </joint>

        <link name="ultrasonic_link"/>
        <joint name="${namespace}ultrasonic_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="ultrasonic_link"/>
            <origin xyz="-0.0267 0 0.009" rpy="0 0 ${pi}"/>
        </joint>

        <link name="ir_mid_link"/>
        <joint name="${namespace}ir_mid_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="ir_mid_link"/>
            <origin xyz="-0.0295 0 -0.015" rpy="0 0 ${pi}"/>
        </joint>

        <link name="ir_l_link"/>
        <joint name="${namespace}ir_l_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="ir_l_link"/>
            <origin xyz="-0.0295 -0.02 -0.015" rpy="0 0 ${pi}"/>
        </joint>

        <link name="ir_r_link"/>
        <joint name="${namespace}ir_r_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="ir_r_link"/>
            <origin xyz="-0.0295 0.02 -0.015" rpy="0 0 ${pi}"/>
        </joint>

        <link name="imu_link"/>
        <joint name="${namespace}imu_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="0.044 0 0.0525" rpy="0 0 ${pi}"/>
        </joint>

        <xacro:if value="${is_sim}">
            <xacro:include filename="$(find pinky)/urdf/pinky_gz.urdf.xacro"/>
            <xacro:insert_gz_sim namespace="${namespace}"/>
        </xacro:if>
    </xacro:macro>
</robot>
