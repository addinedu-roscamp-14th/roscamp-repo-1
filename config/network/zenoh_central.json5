{
  "id": "c012",
  "mode": "router",
  "listen": {
    "endpoints": ["tcp/0.0.0.0:7447"]
  },
  "scouting": {
    "multicast": {"enabled": false},
    "gossip": {"enabled": false}
  },
  "plugins": {
    "ros2dds": {
      "nodename": "zenoh_bridge_central",
      "domain": 12,
      "ros_automatic_discovery_range": "LOCALHOST",
      "allow": {
        "publishers": [
          "/agv[12]/initialpose",
          "/agv[12]/goal_pose",
          "/agv[12]/cmd_vel_manual"
        ],
        "subscribers": [
          "/tf",
          "/tf_static",
          "/agv[12]/map",
          "/agv[12]/keepout_filter_mask",
          "/agv[12]/amcl_pose",
          "/agv[12]/odom",
          "/agv[12]/scan",
          "/agv[12]/plan",
          "/agv[12]/received_global_plan",
          "/agv[12]/global_costmap/costmap",
          "/agv[12]/global_costmap/costmap_updates",
          "/agv[12]/global_costmap/published_footprint",
          "/agv[12]/local_costmap/costmap",
          "/agv[12]/local_costmap/costmap_updates",
          "/agv[12]/local_costmap/published_footprint",
          "/agv[12]/joint_states",
          "/agv[12]/robot_description",
          "/agv[12]/battery/percent",
          "/agv[12]/battery/voltage",
          "/parameter_events",
          "/arm/pick_place/status",
          "/arm/pick_place/work_state",
          "/arm/pick_place/scan_events",
          "/central/inventory/movements",
          "/arm2/transfer_events",
          "/arm2/container_pick/status",
          "/arm2/joint_states"
        ],
        "service_servers": [],
        "service_clients": [
          "/agv[12]/safety_hold",
          "/agv[12]/emergency_stop",
          "/agv[12]/local_costmap/local_costmap/get_parameters",
          "/agv[12]/local_costmap/local_costmap/set_parameters",
          "/agv[12]/local_costmap/local_costmap/describe_parameters",
          "/agv[12]/local_costmap/local_costmap/get_parameter_types",
          "/agv[12]/local_costmap/local_costmap/list_parameters",
          "/agv[12]/local_costmap/local_costmap/set_parameters_atomically",
          "/agv[12]/global_costmap/global_costmap/get_parameters",
          "/agv[12]/global_costmap/global_costmap/set_parameters",
          "/agv[12]/global_costmap/global_costmap/describe_parameters",
          "/agv[12]/global_costmap/global_costmap/get_parameter_types",
          "/agv[12]/global_costmap/global_costmap/list_parameters",
          "/agv[12]/global_costmap/global_costmap/set_parameters_atomically",
          "/agv[12]/local_costmap/clear_entirely_local_costmap",
          "/arm/pick_place/execute",
          "/arm/pick_place/start",
          "/arm/pick_place/stop",
          "/arm/pick_place/scan_ship_destinations",
          "/arm/pick_place/scan_inbound",
          "/arm2/scan_destinations",
          "/arm2/transfer_to_a[123]_[12]",
          "/arm2/load_id[0-8]_to_trailer",
          "/arm2/transfer_by_id",
          "/arm2/go_initial_pose",
          "/arm2/go_a[123]_pose",
          "/arm2/stop_pick",
          "/arm2/reset_stack_level"
        ],
        "action_servers": [],
        "action_clients": [
          "/agv[12]/navigate_to_pose",
          "/agv[12]/navigate_through_poses",
          "/agv[12]/spin",
          "/agv[12]/drive_on_heading",
          "/agv[12]/park_in_spot"
        ]
      },
      "queries_timeout": {
        "default": 5.0,
        "transient_local_subscribers": 3.0,
        "services": 3.0,
        "actions": {
          "send_goal": 5.0,
          "cancel_goal": 5.0,
          "get_result": 3600.0
        }
      }
    }
  }
}
