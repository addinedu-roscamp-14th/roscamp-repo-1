{
  "id": "a014",
  "mode": "client",
  "scouting": {
    "multicast": {"enabled": false},
    "gossip": {"enabled": false}
  },
  "plugins": {
    "ros2dds": {
      "nodename": "zenoh_bridge_agv2",
      "domain": 14,
      "ros_automatic_discovery_range": "LOCALHOST",
      "allow": {
        "publishers": [
          "/tf",
          "/tf_static",
          "/agv2/map",
          "/agv2/keepout_filter_mask",
          "/agv2/amcl_pose",
          "/agv2/shared_amcl_pose",
          "/agv2/odom",
          "/agv2/scan",
          "/agv2/plan",
          "/agv2/joint_states",
          "/agv2/robot_description",
          "/agv2/battery/percent",
          "/agv2/battery/voltage"
        ],
        "subscribers": [
          "/agv1/shared_amcl_pose",
          "/agv2/initialpose",
          "/agv2/goal_pose",
          "/agv2/cmd_vel_manual"
        ],
        "service_servers": [
          "/agv2/safety_hold",
          "/agv2/emergency_stop",
          "/agv2/local_costmap/local_costmap/get_parameters",
          "/agv2/local_costmap/local_costmap/set_parameters"
        ],
        "service_clients": [],
        "action_servers": [
          "/agv2/navigate_to_pose",
          "/agv2/navigate_through_poses",
          "/agv2/spin",
          "/agv2/drive_on_heading",
          "/agv2/park_in_spot"
        ],
        "action_clients": []
      },
      "pub_max_frequencies": [
        "/tf=15",
        "/agv2/scan=5",
        "/agv2/odom=10",
        "/agv2/amcl_pose=10",
        "/agv2/shared_amcl_pose=10",
        "/agv2/joint_states=5"
      ],
      "pub_priorities": [
        "/agv2/amcl_pose=1:express",
        "/agv2/shared_amcl_pose=1:express",
        "/agv2/odom=1:express",
        "/tf=2:express",
        "/agv2/scan=4",
        "/agv2/plan=4"
      ],
      "queries_timeout": {
        "default": 5.0,
        "services": 3.0,
        "actions": {
          "send_goal": 5.0,
          "cancel_goal": 5.0,
          "get_result": 3600.0
        }
      }
    }
  }
}
