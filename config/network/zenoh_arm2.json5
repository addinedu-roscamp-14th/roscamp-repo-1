{
  "id": "r016",
  "mode": "client",
  "scouting": {
    "multicast": {"enabled": false},
    "gossip": {"enabled": false}
  },
  "plugins": {
    "ros2dds": {
      "nodename": "zenoh_bridge_arm2",
      "domain": 16,
      "ros_automatic_discovery_range": "LOCALHOST",
      "allow": {
        "publishers": [
          "/arm2/transfer_events",
          "/arm2/container_pick/status",
          "/arm2/joint_states"
        ],
        "subscribers": [],
        "service_servers": [
          "/arm2/scan_destinations",
          "/arm2/transfer_to_a[123]_[12]",
          "/arm2/load_id[0-8]_to_trailer",
          "/arm2/transfer_by_id",
          "/arm2/go_initial_pose",
          "/arm2/go_a[123]_pose",
          "/arm2/stop_pick",
          "/arm2/reset_stack_level"
        ],
        "service_clients": [],
        "action_servers": [],
        "action_clients": []
      },
      "pub_max_frequencies": [
        "/arm2/joint_states=5"
      ],
      "pub_priorities": [
        "/arm2/transfer_events=1:express",
        "/arm2/container_pick/status=2:express",
        "/arm2/joint_states=5"
      ],
      "queries_timeout": {
        "default": 5.0,
        "transient_local_subscribers": 5.0,
        "services": 5.0,
        "actions": {
          "send_goal": 5.0,
          "cancel_goal": 5.0,
          "get_result": 1800.0
        }
      }
    }
  }
}
